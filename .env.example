# =============================================================================
# Idea Factory Project — Environment Configuration
# Copy to .env (`cp .env.example .env`) and fill in any API keys you want to use.
# All keys are optional: if none are set, the agent uses its built-in Actuarial
# & Combinatorial Synthesis Engine + live public signal scrapers (HN Algolia, SEC Form D).
# =============================================================================

# LLM Provider Priority: anthropic -> claude_cli -> gemini -> openai -> openrouter -> synthesis
# Optional explicit override: "anthropic", "claude_cli", "gemini", "openai", "openrouter", or "synthesis"
IDEA_LLM_PROVIDER=

# Anthropic API (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter API (supports comma-separated free or paid fallback models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free

# 5-Hour Continuous Agent Loop Settings
AGENT_MAX_HOURS=5.0
AGENT_LOOP_INTERVAL_SECONDS=45
AGENT_MAX_CREDIT_USD=50.0
AGENT_STOP_ON_RATE_LIMIT=true

# SEC EDGAR User-Agent (for live Form D private raise signal scraping)
SEC_USER_AGENT=IdeaFactory research@example.com

# Web Dashboard Port (bound to 127.0.0.1)
PORT=8020

# Docker PostgreSQL Database Settings (`docker compose up -d`)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=idea_factory
POSTGRES_USER=idea_factory
POSTGRES_PASSWORD=idea_factory_password
DATABASE_URL=postgresql://idea_factory:idea_factory_password@127.0.0.1:5435/idea_factory


