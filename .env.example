# Idea Factory configuration. Copy to .env (run_agent.sh does this for you).
# .env is git-ignored. Never commit it.

# Required. A paid-tier key from https://aistudio.google.com/apikey
# Gemini 4 Argon is not on the free tier. The model and effort are fixed in code.
GEMINI_API_KEY=

# Required. run_agent.sh generates a random value when it creates .env.
# PostgreSQL only reads this when the volume is first created.
POSTGRES_PASSWORD=
POSTGRES_USER=idea_factory
POSTGRES_DB=idea_factory
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435

# Optional
AGENT_LOOP_INTERVAL_SECONDS=5
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_TIMEOUT_SECONDS=900
PORT=8020
